# Copy this file to .env and fill it in. Never commit .env.

# Where the Amana backend runs.
BACKEND_URL=https://amana-api.favoursunday.dev

# Where the web app lives. The bot sends this link for an order.
PUBLIC_WEB_URL=https://amana-web.onrender.com

# The AI. Optional: without a key the bot still works, with the backend's fixed replies only.
# Create a key with your AI provider and paste it here, never in chat or in code.
AI_API_KEY=
# Any OpenAI-compatible service. The default is Groq. For OpenAI itself use https://api.openai.com/v1
AI_BASE_URL=https://api.groq.com/openai/v1
# The model. The default is OpenAI's open model (gpt-oss) hosted on Groq. At start-up the bot checks
# it against your account and lists the available models if it is wrong.
AI_MODEL=openai/gpt-oss-120b

# Where the WhatsApp login is stored. Keep it private. It is git-ignored.
BOT_AUTH_DIR=./auth_state

# Optional. A file that always holds the newest login QR, so another program can show it on a page.
BOT_QR_FILE=

# Optional. Your number in international digits (for example 2348012345678) to link with a
# pairing code instead of scanning a QR code. Only used the first time.
BOT_PAIRING_PHONE=

# Optional. Comma-separated numbers the bot may answer (for example 2348012345678,2348098765432).
# Leave empty to answer everyone. Recommended while testing.
BOT_ALLOWED_PHONES=

# Messages one person may send per minute before the bot asks them to slow down.
BOT_RATE_LIMIT_PER_MINUTE=8

# SANDBOX ONLY. true signs a sender in to their own number with the backend's debug code, skipping
# the email. Never turn this on for real users.
BOT_AUTO_LOGIN_DEBUG=false

# ---------------------------------------------------------------------------------------------
# Running on Vercel with the official WhatsApp Business Platform (Cloud API). Set these in the
# Vercel project's Environment Variables, not in a file. See README, "Deploy on Vercel".
# ---------------------------------------------------------------------------------------------
# A word you choose. Paste the same word into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Used to check that calls really come from Meta.
WHATSAPP_APP_SECRET=
# A permanent access token (System User) with the whatsapp_business_messaging permission.
WHATSAPP_TOKEN=
# WhatsApp > API setup > Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
# Where chat state is kept between messages (Upstash Redis; Vercel's Marketplace can add it).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random text. Encrypts the stored state (it includes sign-in tokens). Keep it secret.
STATE_SECRET=
