# Copy this file to .env.local and fill in the values. Never commit .env.local.
# VITE_ values are public: they are bundled into the browser code. No secrets here.

# Staging API: https://amana-api.favoursunday.dev
# Local backend: http://localhost:3001
VITE_API_URL=

# Optional. Set to true to pre-fill the sign-in code while the backend returns a debug code.
# Leave unset in a real build.
VITE_AUTOFILL_OTP=
